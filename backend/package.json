{
  "name": "quicken-tree-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed-content.ts && tsx src/seed-operational.ts",
    "seed:content": "tsx src/seed-content.ts",
    "seed:operational": "tsx src/seed-operational.ts",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:relational": "tsx src/migrate-relational-content.ts",
    "clear:members": "tsx src/clear-members.ts",
    "restore:wings": "tsx src/restore-wings-wednesday.ts",
    "add:menu-availability": "tsx src/add-menu-availability.ts",
    "add:kids-menu": "tsx src/add-kids-menu.ts",
    "split:menu-availability": "tsx src/split-menu-availability.ts",
    "add:toasted-sandwich-options": "tsx src/add-toasted-sandwich-options.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0"
  }
}
