# Set the real public HTTPS origin before building for production.
SITE_URL=
# Public backend origin used by the contact form.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Keep true on preview/staging deployments. Use false for the public launch.
SITE_NOINDEX=false
# Optional Search Console ownership verification token.
GOOGLE_SITE_VERIFICATION=
# Server-only Mailtrap API settings for the contact form.
MAILTRAP_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Pace
MAIL_TO_ADDRESS=
