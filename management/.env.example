DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/quicken_tree
# Development only: connect to Production through an SSH tunnel; do not expose PostgreSQL publicly.
PRODUCTION_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55439/DATABASE
PRODUCTION_SSH_HOST=YOUR_VPS_IP
PRODUCTION_SSH_USER=root
PRODUCTION_SSH_KEY=/absolute/path/to/private_key
PORT=4100
# Set to require for a remote database; defaults to require outside localhost.
# DATABASE_SSL=require
